# Plantilla de variables de entorno para producción
# Copiar a .env en el servidor y completar valores NO secretos
# Los secretos (DB_PASSWORD, DB_ROOT_PASSWORD, SESSION_SECRET) se cargan desde Docker secrets

# Origen público HTTPS obligatorio (ej: https://cateringoculto.bajastack.network)
PUBLIC_ORIGIN=

# Base de datos (nombres de servicio Docker en red interna)
DB_HOST=db
DB_PORT=3306
DB_NAME=catering_oculto
DB_USER=catering_app

# Entorno
APP_ENV=production

# Confianza en proxy (IP/red del Caddy en red Docker platform_proxy)
# Ejemplo: uniquelocal  (para red Docker interna)
TRUST_PROXY=uniquelocal

# Directorio de medios persistente (volumen Docker)
MEDIA_DIRECTORY=/app/media

# Puerto interno del contenedor
PORT=3000

# Interfaz de escucha (0.0.0.0 para todas en contenedor)
BIND_HOST=0.0.0.0

# ============================================
# NO PONER ESTOS VALORES EN ESTE ARCHIVO:
# ============================================
# DB_PASSWORD=           -> Cargar desde /run/secrets/db_password
# DB_ROOT_PASSWORD=      -> Cargar desde /run/secrets/db_root_password
# SESSION_SECRET=        -> Cargar desde /run/secrets/session_secret
# (Mínimo 32 caracteres, generar con: openssl rand -hex 48)